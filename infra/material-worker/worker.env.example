# Copy to a root-only runtime file on the Worker host; never commit real values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
MATERIAL_WORKER_SECRET=replace-with-random-64-hex-character-capability
MATERIAL_API_URL=https://agent.stardust.website

# Do NOT configure WOPALLY_* or USER_CONFIG_ENCRYPTION_KEY here.
# Inference runs through Vercel's lease-checked internal relay.
# Enable only after deploying the observability migration. Uses the existing active
# Worker capability + lease; no ops/read capability is installed on this host.
OBSERVABILITY_ENABLED=false
