# Cloud deployment (Vercel project environment variables)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Cloudflare Turnstile CAPTCHA protection for signup (optional)
TURNSTILE_SITE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Alternative narrow backend capability (recommended for this deployment).
WORKBENCH_BACKEND_SECRET=
# 独立的用户模型配置 AES-256 密钥（32字节 URL-safe Base64）；保留备份，不可随意更换。
USER_CONFIG_ENCRYPTION_KEY=

# Wopally card redemption; disabled until the station owner approves the service account/shop.
WORKBENCH_CARD_REDEMPTION_APPROVED=false
WORKBENCH_CARD_REDEMPTION_PAUSED=true
WORKBENCH_REDEEM_ENCRYPTION_KEY=
WOPALLY_REDEEM_API_VERIFIED=false
WOPALLY_API_URL=https://api.wopally.cn
# Optional origin pin when edge/WAF rejects Vercel traffic. TLS still verifies api.wopally.cn.
WOPALLY_ORIGIN_IP=
WOPALLY_SERVICE_ACCESS_TOKEN=
# Prefer a dedicated low-privilege service login over a manually rotated JWT.
WOPALLY_SERVICE_EMAIL=
WOPALLY_SERVICE_PASSWORD=
WOPALLY_SERVICE_USER_ID=
WOPALLY_CARD_REDEEM_PATH=
WOPALLY_CARD_REDEEM_HISTORY_PATH=
WOPALLY_CARD_SHOP_URL=
WOPALLY_ALLOWED_CARD_VALUES_CNY=
# Workbench-issued shop codes stay disabled until the batch is imported,
# funded, and the metered model bundle is ready.
WORKBENCH_VOUCHERS_APPROVED=false
WORKBENCH_VOUCHERS_PAUSED=true
WORKBENCH_SHOW_SHOP_LINK=false
WORKBENCH_MODEL_BUNDLE_READY=false
WORKBENCH_MODEL_BUNDLE_PAUSED=true
WOPALLY_MODEL_BASE_URL=https://api.wopally.cn/v1
WOPALLY_WORKBENCH_API_KEY=
WOPALLY_WORKBENCH_API_KEY_ID=
SUB2_PAYMENT_WEBHOOK_SECRET=
SUB2_PAYMENT_MAX_CNY=10000

# Optional local Ollama configuration. Leave unset on Vercel.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Enable ONLY after deploying infra/storage-worker and configuring the private bucket limit.
STORAGE_UPLOAD_PROXY_ENABLED=false
# 大创创新训练试点：默认关闭，迁移和独立 Worker 验收后再启用。
MATERIAL_PIPELINE_ENABLED=false
MATERIAL_WORKER_READY=false
# Worker 专用能力密钥只放在 Worker 主机的 root-only 环境文件中；
# 数据库只保存 SHA-256。生产 Worker 通过 Vercel 内部代理调用模型。
# Worker 镜像已配置字体和 Chromium；本机测试可覆盖：
# MATERIAL_FONT_PATH=/path/to/licensed-cjk-font
# MATERIAL_CHROMIUM_PATH=/path/to/chromium
